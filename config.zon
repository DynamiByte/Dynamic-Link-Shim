.{
    // DLL to read exports from, or a compiled .dls surface.
    .input = "Library.dll",

    // Optional original DLL bytes for output-pair or embed-dlls with .dls input.
    .backing = null,

    // Real DLL to forward exports to. Null derives from input.
    // (Library.dll > Library.og.dll)
    .forward = null,

    // Generated proxy DLL name. Null uses input basename.
    .output = null,

    // .runtime_stub or .pe_forwarder
    .method = .runtime_stub,

    // Extra DLLs to load.
    .load = .{
        "Patch.dll",
    },

    // Load every *.dls.dll file beside the proxy DLL.
    .autoload = false,

    // Used only by .pe_forwarder.
    .load_import = "#1",

    // Optional output copy directory.
    .copy_to = null,

    // Also place the backing DLL beside the generated proxy.
    .output_pair = false,

    // Embed the backing DLL and load DLLs into the generated runtime stub.
    .embed_dlls = false,

    // Restart the host through suspended-process injection if load DLLs are missing.
    .bootstrap = false,

    .forwarding = .{
        .include_ordinals = true,
        .include_data_exports = true,
        .fail_on_unsupported = true,
    },
}
